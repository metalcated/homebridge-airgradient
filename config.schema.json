{
  "pluginAlias": "AirGradientPlatform",
  "pluginType": "platform",
  "headerDisplay": "AirGradient Configuration",
  "schema": {
    "type": "object",
    "properties": {
      "fetchLogs": {
        "title": "Fetch Logs",
        "type": "boolean",
        "default": true,
        "description": "Enable routine fetch and update logging. Offline/recovery and configuration warnings remain visible."
      },
      "verboseLogs": {
        "title": "Verbose Logs",
        "type": "boolean",
        "default": false,
        "description": "When enabled, log messages include full data payloads and stack traces."
      },
      "sensors": {
        "type": "array",
        "title": "AirGradient Sensors",
        "items": {
          "type": "object",
          "properties": {
            "serialno": {
              "title": "Serial Number",
              "type": "string",
              "required": true
            },
            "pollingInterval": {
              "title": "Polling Interval (ms)",
              "type": "integer",
              "default": 60000,
              "minimum": 1000,
              "maximum": 86400000
            },
            "useCompensatedValues": {
              "title": "Use Compensated Values",
              "type": "boolean",
              "default": false
            },
            "co2AlertThreshold": {
              "type": "number",
              "title": "CO2 Alert Threshold",
              "default": 800,
              "description": "The CO\u2082 level (ppm) above which HomeKit shows an alert.",
              "minimum": 1,
              "maximum": 100000
            },
            "offlineAfterFailures": {
              "type": "integer",
              "title": "Failures Before Offline",
              "default": 3,
              "minimum": 1,
              "description": "Consecutive failed polls before the sensor is shown as \"No Response\" in HomeKit. At the default polling interval, 3 is about three minutes of silence."
            },
            "host": {
              "title": "Hostname or IP address (optional)",
              "type": "string",
              "description": "Leave blank to use the serial number\u2019s .local hostname. Do not include http:// or a path."
            },
            "port": {
              "title": "HTTP port",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 80
            },
            "apiVersion": {
              "title": "Device API",
              "type": "string",
              "enum": [
                "auto",
                "legacy",
                "v1"
              ],
              "default": "auto"
            },
            "requestTimeout": {
              "title": "Request timeout (ms)",
              "type": "integer",
              "minimum": 100,
              "maximum": 60000,
              "default": 10000
            },
            "co2ClearThreshold": {
              "title": "CO\u2082 clear threshold (ppm)",
              "type": "number",
              "minimum": 0,
              "description": "Must be lower than the alert threshold. Defaults to 50 ppm below it."
            },
            "co2AlertDuration": {
              "title": "CO\u2082 above-threshold duration (ms)",
              "type": "integer",
              "minimum": 0,
              "maximum": 3600000,
              "default": 0
            },
            "historyDays": {
              "title": "History retention (days)",
              "type": "integer",
              "minimum": 0,
              "maximum": 365,
              "default": 0,
              "description": "0 disables history. Stored in a local SQLite database; capped at 10,000 samples per monitor."
            },
            "enableDisplayControls": {
              "title": "Enable display and LED brightness controls",
              "type": "boolean",
              "default": false,
              "description": "Opt in to device changes through HomeKit. Only supported controls accepting local changes are exposed."
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "type": "section",
      "items": [
        {
          "key": "verboseLogs",
          "type": "checkbox",
          "title": "Verbose Logs"
        },
        {
          "key": "fetchLogs",
          "type": "checkbox",
          "title": "Fetch Logs"
        },
        {
          "key": "sensors",
          "type": "array",
          "add": "Add Sensor",
          "items": [
            {
              "key": "sensors[].serialno",
              "placeholder": "Enter your Serial Number"
            },
            {
              "key": "sensors[].pollingInterval",
              "placeholder": 60000
            },
            {
              "key": "sensors[].useCompensatedValues",
              "type": "checkbox",
              "title": "Use Compensated Values"
            },
            {
              "key": "sensors[].co2AlertThreshold",
              "placeholder": 800
            },
            {
              "key": "sensors[].offlineAfterFailures",
              "placeholder": 3
            },
            {
              "key": "sensors[].host"
            },
            {
              "key": "sensors[].port"
            },
            {
              "key": "sensors[].apiVersion"
            },
            {
              "key": "sensors[].requestTimeout"
            },
            {
              "key": "sensors[].co2ClearThreshold"
            },
            {
              "key": "sensors[].co2AlertDuration"
            },
            {
              "key": "sensors[].historyDays"
            },
            {
              "key": "sensors[].enableDisplayControls"
            }
          ]
        }
      ]
    }
  ],
  "customUi": true,
  "singular": true
}
