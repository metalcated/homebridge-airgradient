{
  "id": "com.metalcated.lennox",
  "version": "0.1.2",
  "compatibility": ">=12.9.0",
  "runtime": "nodejs",
  "sdk": 3,
  "platforms": ["local"],
  "name": { "en": "Lennox" },
  "description": { "en": "Comfort, connected locally" },
  "category": ["climate"],
  "brandColor": "#BD2025",
  "author": { "name": "metalcated" },
  "permissions": [],
  "capabilities": {
    "heat_target": {
      "type": "number",
      "title": { "en": "Heating target" },
      "units": { "en": "°C" },
      "decimals": 1,
      "min": 4,
      "max": 35,
      "step": 0.5,
      "getable": true,
      "setable": true,
      "insights": true,
      "chartType": "stepLine",
      "uiComponent": "thermostat"
    },
    "cool_target": {
      "type": "number",
      "title": { "en": "Cooling target" },
      "units": { "en": "°C" },
      "decimals": 1,
      "min": 4,
      "max": 35,
      "step": 0.5,
      "getable": true,
      "setable": true,
      "insights": true,
      "chartType": "stepLine",
      "uiComponent": "thermostat"
    },
    "hvac_state": {
      "type": "enum",
      "title": { "en": "Operating state" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "values": [
        { "id": "idle", "title": { "en": "Idle" } },
        { "id": "heating", "title": { "en": "Heating" } },
        { "id": "cooling", "title": { "en": "Cooling" } },
        { "id": "defrost", "title": { "en": "Defrosting" } },
        { "id": "unknown", "title": { "en": "Unknown" } }
      ]
    },
    "fan_mode": {
      "type": "enum",
      "title": { "en": "Fan mode" },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        { "id": "auto", "title": { "en": "Automatic" } },
        { "id": "on", "title": { "en": "On" } },
        { "id": "circulate", "title": { "en": "Circulate" } }
      ]
    }
  },
  "drivers": [
    {
      "id": "thermostat",
      "name": { "en": "iComfort local thermostat" },
      "class": "thermostat",
      "platforms": ["local"],
      "connectivity": ["lan"],
      "capabilities": ["measure_temperature", "thermostat_mode", "hvac_state"],
      "capabilitiesOptions": {
        "measure_temperature": { "decimals": 1 },
        "target_temperature": { "step": 0.5 }
      },
      "settings": [
        {
          "id": "host",
          "type": "text",
          "label": { "en": "Thermostat address" },
          "value": "",
          "hint": { "en": "Local IP address or hostname. Changing it verifies the same thermostat and zone before reconnecting." }
        },
        {
          "id": "read_only",
          "type": "checkbox",
          "label": { "en": "Read-only mode" },
          "value": true,
          "hint": { "en": "Keep enabled to monitor without changing your heating or cooling. Disable to allow temperature, mode and fan commands from Homey and Flows." }
        }
      ],
      "pair": [
        { "id": "connect" },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": { "prev": "connect", "next": "add_devices" }
        },
        { "id": "add_devices", "template": "add_devices" }
      ],
      "repair": [{ "id": "connect", "options": { "repair": true } }]
    }
  ],
  "flow": {
    "actions": [
      {
        "id": "heat_target_set",
        "title": { "en": "Set the heating target" },
        "titleFormatted": { "en": "Set the heating target to [[temperature]]" },
        "hint": { "en": "Requires Read-only mode to be disabled. The existing cooling target and thermostat mode are preserved." },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=thermostat&capabilities=heat_target" },
          { "name": "temperature", "type": "number", "title": { "en": "Temperature (°C)" }, "min": 4, "max": 35, "step": 0.5 }
        ]
      },
      {
        "id": "cool_target_set",
        "title": { "en": "Set the cooling target" },
        "titleFormatted": { "en": "Set the cooling target to [[temperature]]" },
        "hint": { "en": "Requires Read-only mode to be disabled. The existing heating target and thermostat mode are preserved." },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=thermostat&capabilities=cool_target" },
          { "name": "temperature", "type": "number", "title": { "en": "Temperature (°C)" }, "min": 4, "max": 35, "step": 0.5 }
        ]
      },
      {
        "id": "fan_mode_set",
        "title": { "en": "Set the fan mode" },
        "titleFormatted": { "en": "Set the fan to [[mode]]" },
        "hint": { "en": "Requires Read-only mode to be disabled. Unsupported fan modes are rejected." },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=thermostat&capabilities=fan_mode" },
          {
            "name": "mode",
            "type": "dropdown",
            "values": [
              { "id": "auto", "label": { "en": "Automatic" } },
              { "id": "on", "label": { "en": "On" } },
              { "id": "circulate", "label": { "en": "Circulate" } }
            ]
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "hvac_state_is",
        "title": { "en": "The thermostat !{{is|is not}} operating in" },
        "titleFormatted": { "en": "The thermostat !{{is|is not}} [[state]]" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=thermostat&capabilities=hvac_state" },
          {
            "name": "state",
            "type": "dropdown",
            "values": [
              { "id": "idle", "label": { "en": "Idle" } },
              { "id": "heating", "label": { "en": "Heating" } },
              { "id": "cooling", "label": { "en": "Cooling" } },
              { "id": "defrost", "label": { "en": "Defrosting" } }
            ]
          }
        ]
      }
    ]
  }
}
