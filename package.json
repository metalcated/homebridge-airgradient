{
  "private": false,
  "displayName": "AirGradient",
  "name": "@metalcated/homebridge-airgradient",
  "version": "3.1.0-beta.1",
  "description": "Fetches air quality information from AirGradient devices.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metalcated/homebridge-airgradient.git"
  },
  "bugs": {
    "url": "https://github.com/metalcated/homebridge-airgradient/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint src/**/*.ts --max-warnings=0 && node --check homebridge-ui/server.js && node --check homebridge-ui/public/app.js",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build && npm test",
    "test": "node --test test/*.test.cjs",
    "emulate": "node test/serve-emulator.cjs"
  },
  "keywords": [
    "homebridge-plugin",
    "air gradient",
    "air quality",
    "pm2.5",
    "co2",
    "tvoc"
  ],
  "engines": {
    "homebridge": "^1.6.0 || ^2.0.0-beta.0 || ^2.4.1-beta.0",
    "node": "^22.13.0 || ^24 || ^26"
  },
  "peerDependencies": {
    "homebridge": ">=1.6.0 || ^2.4.1-beta.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "homebridge": "^1.8.0",
    "nodemon": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "jsdom": "^26.1.0"
  },
  "homepage": "https://github.com/metalcated/homebridge-airgradient#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
